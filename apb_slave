
`timescale 1ns/1ps

module apb_slave #(
      parameter WAIT_CYCLES = 0
)(
      input wire pclk,
      input wire presetn,
      input wire psel,
      input wire penable,
      input wire pwrite,
  input wire [7:0] paddr,
  input wire [7:0] pwdata,

  output reg [7:0] prdata,
      output reg pready
);

  reg [7:0] memory [0:255];
      integer wait_count;
      integer i;

  always @(posedge pclk or negedge presetn) begin
    if (!presetn) begin
                  wait_count <= 0;

      for (i = 0; i < 256; i = i + 1)
        memory[i] <= 8'h00;
    end
            else begin
              if (psel && !penable) begin
                                wait_count <= WAIT_CYCLES;
              end
              else if (psel && penable) begin
                if (wait_count > 0) begin
                                      wait_count <= wait_count - 1;
                end
                else if (pwrite) begin
                  memory[paddr] <= pwdata;
                end
              end
            end
  end

  always @(*) begin
            prdata = 8'h00;
            pready = 1'b0;

    if (psel && penable) begin
      if (wait_count == 0) begin
                        pready = 1'b1;

        if (!pwrite)
          prdata = memory[paddr];
      end
    end
  end

endmodule
